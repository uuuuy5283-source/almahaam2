package com.mahaam.recorder

import android.app.Application
import android.app.admin.DeviceAdminReceiver
import android.content.BroadcastReceiver
import android.content.Context
import android.content.Intent
import java.util.Calendar
import java.util.Locale
import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import androidx.core.app.NotificationCompat
import androidx.work.ExistingPeriodicWorkPolicy
import androidx.work.PeriodicWorkRequestBuilder
import androidx.work.Worker
import androidx.work.WorkerParameters
import java.util.concurrent.TimeUnit

class App : Application() {
    override fun onCreate() {
        super.onCreate()
        Notifier.ensureChannels(this)
        Prefs.ensureBaseline(this)
        MonthlyWorker.schedule(this)
    }
}

class AdminReceiver : DeviceAdminReceiver()

class BootReceiver : BroadcastReceiver() {
    override fun onReceive(context: Context, intent: Intent?) {
        if (intent?.action == Intent.ACTION_BOOT_COMPLETED) {
            Notifier.ensureChannels(context)
            Prefs.ensureBaseline(context)
            MonthlyWorker.schedule(context)
        }
    }
}

object Prefs {
    private const val FILE = "mahaam_prefs"
    private val MONTHS = arrayOf(
        "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو",
        "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"
    )

    private fun sp(c: Context) = c.getSharedPreferences(FILE, Context.MODE_PRIVATE)

    fun nextNumber(c: Context): Int = sp(c).getInt("next_number", 1)
    fun setNextNumber(c: Context, n: Int) = sp(c).edit().putInt("next_number", n).apply()

    fun treeUri(c: Context): String? = sp(c).getString("tree_uri", null)
    fun setTreeUri(c: Context, s: String?) {
        val e = sp(c).edit()
        if (s == null) e.remove("tree_uri") else e.putString("tree_uri", s)
        e.apply()
    }

    fun permissionsAsked(c: Context): Boolean = sp(c).getBoolean("perm_asked", false)
    fun setPermissionsAsked(c: Context) = sp(c).edit().putBoolean("perm_asked", true).apply()

    fun monthKey(cal: Calendar = Calendar.getInstance()): String =
        String.format(Locale.US, "%04d-%02d", cal.get(Calendar.YEAR), cal.get(Calendar.MONTH) + 1)

    fun prevMonthKey(): String {
        val cal = Calendar.getInstance()
        cal.set(Calendar.DAY_OF_MONTH, 1)
        cal.add(Calendar.MONTH, -1)
        return monthKey(cal)
    }

    fun monthLabel(key: String): String {
        val y = key.substring(0, 4)
        val m = key.substring(5, 7).toInt()
        return "${MONTHS[m - 1]} $y"
    }

    fun monthCount(c: Context, key: String = monthKey()): Int = sp(c).getInt("count_$key", 0)

    fun incrementMonth(c: Context) {
        val k = "count_${monthKey()}"
        sp(c).edit().putInt(k, sp(c).getInt(k, 0) + 1).apply()
    }

    fun lastReported(c: Context): String? = sp(c).getString("last_reported", null)
    fun setLastReported(c: Context, key: String) = sp(c).edit().putString("last_reported", key).apply()

    fun ensureBaseline(c: Context) {
        if (lastReported(c) == null) setLastReported(c, prevMonthKey())
    }
}

object RecordingState {
    @Volatile var isRecording = false
    @Volatile var number = 0
    @Volatile var startElapsed = 0L
    @Volatile var lastSaved = 0
    @Volatile var lastFallback = false
    @Volatile var lastError: String? = null

    fun begin(n: Int) {
        number = n
        startElapsed = android.os.SystemClock.elapsedRealtime()
        lastSaved = 0
        lastFallback = false
        lastError = null
        isRecording = true
    }

    fun end(savedNumber: Int, fallback: Boolean, error: String?) {
        isRecording = false
        lastSaved = savedNumber
        lastFallback = fallback
        lastError = error
    }

    fun fail(error: String) {
        isRecording = false
        lastSaved = 0
        lastError = error
    }
}

object Notifier {
    const val CH_REC = "recording"
    const val CH_SAVED = "saved"
    const val CH_MONTHLY = "monthly"
    const val ID_REC = 1001
    const val ID_SAVED = 1002
    const val ID_MONTHLY = 1003

    fun ensureChannels(c: Context) {
        val nm = c.getSystemService(NotificationManager::class.java)
        nm.createNotificationChannel(
            NotificationChannel(CH_REC, c.getString(R.string.ch_recording), NotificationManager.IMPORTANCE_LOW)
        )
        nm.createNotificationChannel(
            NotificationChannel(CH_SAVED, c.getString(R.string.ch_saved), NotificationManager.IMPORTANCE_DEFAULT)
        )
        nm.createNotificationChannel(
            NotificationChannel(CH_MONTHLY, c.getString(R.string.ch_monthly), NotificationManager.IMPORTANCE_DEFAULT)
        )
    }

    private fun openApp(c: Context): PendingIntent = PendingIntent.getActivity(
        c, 0,
        Intent(c, MainActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_SINGLE_TOP or Intent.FLAG_ACTIVITY_CLEAR_TOP),
        PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
    )

    fun recording(c: Context, number: Int, startWall: Long): Notification {
        val stop = PendingIntent.getService(
            c, 1,
            Intent(c, RecordingService::class.java).setAction(RecordingService.ACTION_STOP),
            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
        )
        return NotificationCompat.Builder(c, CH_REC)
            .setSmallIcon(R.drawable.ic_notification)
            .setContentTitle(c.getString(R.string.app_name))
            .setContentText(c.getString(R.string.notif_recording_text, number))
            .setOngoing(true)
            .setOnlyAlertOnce(true)
            .setUsesChronometer(true)
            .setWhen(startWall)
            .setCategory(NotificationCompat.CATEGORY_SERVICE)
            .setForegroundServiceBehavior(NotificationCompat.FOREGROUND_SERVICE_IMMEDIATE)
            .setContentIntent(openApp(c))
            .addAction(0, c.getString(R.string.notif_stop), stop)
            .build()
    }

    fun postSaved(c: Context, text: String) {
        val n = NotificationCompat.Builder(c, CH_SAVED)
            .setSmallIcon(R.drawable.ic_notification)
            .setContentTitle(c.getString(R.string.app_name))
            .setContentText(text)
            .setStyle(NotificationCompat.BigTextStyle().bigText(text))
            .setAutoCancel(true)
            .setContentIntent(openApp(c))
            .build()
        c.getSystemService(NotificationManager::class.java).notify(ID_SAVED, n)
    }

    fun postMonthly(c: Context, monthKey: String, count: Int) {
        val text = c.getString(R.string.notif_monthly_text, Prefs.monthLabel(monthKey), count)
        val n = NotificationCompat.Builder(c, CH_MONTHLY)
            .setSmallIcon(R.drawable.ic_notification)
            .setContentTitle(c.getString(R.string.app_name))
            .setContentText(text)
            .setAutoCancel(true)
            .setContentIntent(openApp(c))
            .build()
        c.getSystemService(NotificationManager::class.java).notify(ID_MONTHLY, n)
    }
}

class MonthlyWorker(ctx: Context, params: WorkerParameters) : Worker(ctx, params) {

    override fun doWork(): Result {
        val c = applicationContext
        Prefs.ensureBaseline(c)
        val prev = Prefs.prevMonthKey()
        val last = Prefs.lastReported(c) ?: prev
        if (prev > last) {
            Notifier.ensureChannels(c)
            Notifier.postMonthly(c, prev, Prefs.monthCount(c, prev))
            Prefs.setLastReported(c, prev)
        }
        return Result.success()
    }

    companion object {
        fun schedule(c: Context) {
            val req = PeriodicWorkRequestBuilder<MonthlyWorker>(1, TimeUnit.DAYS).build()
            androidx.work.WorkManager.getInstance(c).enqueueUniquePeriodicWork(
                "monthly_report", ExistingPeriodicWorkPolicy.KEEP, req
            )
        }
    }
}
